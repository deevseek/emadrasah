APP_NAME="E-Madrasah MI Muslimat NU"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Jakarta
LOG_CHANNEL=stack
LOG_LEVEL=debug
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=emadrasah
DB_USERNAME=root
DB_PASSWORD=
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=public
MAIL_MAILER=log
SEED_ADMIN_NAME="Administrator"
SEED_ADMIN_USERNAME=administrator
SEED_ADMIN_EMAIL=admin@example.test
SEED_ADMIN_PASSWORD=
MADRASAH_NAME="MI Muslimat NU Demak"
MADRASAH_APP_NAME="e-Madrasah"
MADRASAH_LOGO=

FACE_RECOGNITION_DRIVER=python
FACE_RECOGNITION_URL=http://127.0.0.1:8791
FACE_RECOGNITION_TOKEN=
FACE_RECOGNITION_TIMEOUT=10

# Bank BRI (nonaktif secara default; isi hanya setelah onboarding produk resmi)
# Nilai BRI dapat dikonfigurasi melalui Pengaturan Aplikasi > Integrasi Bank BRI
# dan akan otomatis disinkronkan ke .env.
BRI_ENABLED=false
BRI_ENV=sandbox
BRI_BASE_URL=
BRI_CLIENT_ID=
BRI_CLIENT_SECRET=
BRI_PARTNER_ID=
BRI_CHANNEL_ID=
BRI_PRIVATE_KEY_PATH=
BRI_PUBLIC_KEY_PATH=
BRI_REGISTERED_ACCOUNT_NUMBER=
BRI_TIMESTAMP_TOLERANCE=300
BRI_TIMEOUT=20
BRI_BRIVA_ENABLED=false
BRI_BRIVA_PARTNER_SERVICE_ID=
BRI_BRIVA_INSTITUTION_CODE=
BRI_BRIVA_CUSTOMER_PREFIX=
BRI_BRIVA_MODE=per_student
BRI_QRIS_ENABLED=false
BRI_QRIS_MERCHANT_ID=
BRI_QRIS_TERMINAL_ID=
BRI_QRIS_SERVICE_CODE=
BRI_QRIS_NOTIFICATION_SUCCESS_CODE=
BRI_PAYROLL_ENABLED=false
BRI_SOURCE_ACCOUNT=
BRI_INTRABANK_SERVICE_CODE=
BRI_INTERBANK_SERVICE_CODE=
BRI_STATUS_INQUIRY_SERVICE_CODE=
# Endpoint produk di bawah wajib berasal dari dokumentasi/onboarding BRI yang berlaku.
BRI_PATH_BANK_STATEMENT=
BRI_PATH_QRIS_GENERATE=
BRI_PATH_TRANSACTION_STATUS=
BRI_PATH_INTRABANK_TRANSFER=
BRI_PATH_INTERBANK_TRANSFER=
BRI_DIRECT_DEBIT_ENABLED=false
